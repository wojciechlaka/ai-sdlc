{
  "name": "refinement-engine",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "concurrently -n be,fe -c blue,green \"npm run dev -w apps/backend\" \"wait-on tcp:3000 && npm run dev -w apps/frontend\"",
    "dev:web": "npm run dev -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.3",
    "wait-on": "^9.1.0"
  }
}
